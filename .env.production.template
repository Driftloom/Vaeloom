# ─── Vaeloom Production Environment Configuration ─────────────────────────
# Copy this file to .env.production and fill in all required values.
# REQUIRED  = must be set before starting the service
# OPTIONAL  = has a safe default, override if needed
# SECRET    = must be kept confidential (never commit to git)

# ═══════════════════════════════════════════════════════════════════════════
# Service Identity
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED: Service name for telemetry and logging
SERVICE_NAME=vaeloom-backend

# OPTIONAL: Service version (defaults to 0.2.0)
SERVICE_VERSION=0.2.0

# REQUIRED: Deployment environment
SERVICE_ENVIRONMENT=production

# ═══════════════════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED (SECRET): PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE__URL=postgresql+asyncpg://vaeloom:CHANGEME@vaeloom-prod-postgres.xxxxxx.us-east-1.rds.amazonaws.com:5432/vaeloom

# ═══════════════════════════════════════════════════════════════════════════
# Redis
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED (SECRET): Redis connection string (use password if AUTH enabled)
# Format: redis://[:password]@host:port/db
REDIS__URL=redis://:CHANGEME@vaeloom-prod-redis.xxxxxx.ng.0001.use1.cache.amazonaws.com:6379/0

# ═══════════════════════════════════════════════════════════════════════════
# JWT Authentication
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED (SECRET): JWT signing secret (min 32 chars, use `openssl rand -hex 64`)
JWT_SECRET=change-me-in-production-min-32-chars-long

# OPTIONAL: JWT signing algorithm
JWT_ALGORITHM=HS256

# OPTIONAL: Access token TTL in seconds (default: 3600 = 1 hour)
JWT_TOKEN_TTL=3600

# OPTIONAL: Refresh token TTL in seconds (default: 2592000 = 30 days)
JWT_REFRESH_TOKEN_TTL=2592000

# ═══════════════════════════════════════════════════════════════════════════
# Encryption
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED (SECRET): Encryption key for sensitive data at rest (min 32 chars)
ENCRYPTION_KEY=change-me-in-production-min-32-chars-long

# ═══════════════════════════════════════════════════════════════════════════
# LLM / AI Provider
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED: LLM provider - "anthropic" or "openai"
LLM_PROVIDER=anthropic

# REQUIRED (SECRET): API key for the LLM provider
LLM_API_KEY=sk-ant-xxxxxxxxxxxx

# OPTIONAL: Model name for LLM (default: claude-3-5-sonnet-20241022)
LLM_MODEL=claude-3-5-sonnet-20241022

# OPTIONAL: Embedding model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# ═══════════════════════════════════════════════════════════════════════════
# Google Integration (Calendar, Gmail)
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL (SECRET): Google OAuth client ID
GOOGLE_CLIENT_ID=

# OPTIONAL (SECRET): Google OAuth client secret
GOOGLE_CLIENT_SECRET=

# OPTIONAL (SECRET): Google OAuth refresh token
GOOGLE_REFRESH_TOKEN=

# OPTIONAL: Google Calendar ID (default: primary)
GOOGLE_CALENDAR_ID=primary

# ═══════════════════════════════════════════════════════════════════════════
# Job Board Integration
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL: Job board API base URL
JOB_BOARD_API_URL=

# OPTIONAL (SECRET): Job board API key
JOB_BOARD_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED: Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=https://vaeloom.app,https://api.vaeloom.app

# ═══════════════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL: Log level (DEBUG, INFO, WARNING, ERROR; default: INFO)
LOG_LEVEL=INFO

# OPTIONAL: Log format - "json", "pretty", or "" for auto-detect (default: json in prod)
LOG_FORMAT=json

# ═══════════════════════════════════════════════════════════════════════════
# Rate Limiting
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED: Redis URL for rate limit storage (same as REDIS__URL typically)
RATE_LIMIT_REDIS_URL=redis://:CHANGEME@vaeloom-prod-redis.xxxxxx.ng.0001.use1.cache.amazonaws.com:6379/0

# OPTIONAL: Max requests per window (default: 100)
RATE_LIMIT_REQUESTS=100

# OPTIONAL: Rate limit window in seconds (default: 60)
RATE_LIMIT_WINDOW=60

# ═══════════════════════════════════════════════════════════════════════════
# S3-Compatible Object Storage
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED: S3 endpoint URL (use AWS S3 or compatible service)
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com

# REQUIRED (SECRET): S3 access key
STORAGE_ACCESS_KEY=AKIAXXXXXXXXXXXX

# REQUIRED (SECRET): S3 secret key
STORAGE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED: S3 bucket name for file uploads
STORAGE_BUCKET=vaeloom-prod-uploads

# OPTIONAL: S3 region (default: us-east-1)
STORAGE_REGION=us-east-1

# ═══════════════════════════════════════════════════════════════════════════
# SSO / Enterprise Auth
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL: JSON object of SSO provider configs
# {"google":{"client_id":"","client_secret":"","redirect_uri":""},"microsoft":{"tenant_id":"","client_id":"","client_secret":"","redirect_uri":""}}
SSO_PROVIDERS={}

# ═══════════════════════════════════════════════════════════════════════════
# Observability
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL: OpenTelemetry OTLP endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://vaeloom-otel-collector:4318

# OPTIONAL: OpenTelemetry service name
OTEL_SERVICE_NAME=vaeloom-backend

# OPTIONAL (SECRET): Sentry DSN for error tracking
SENTRY_DSN=

# OPTIONAL: Enable Prometheus metrics endpoint (/metrics)
PROMETHEUS_METRICS_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════
# SMTP / Email
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL: SMTP host
SMTP_HOST=

# OPTIONAL: SMTP port (default: 587)
SMTP_PORT=587

# OPTIONAL (SECRET): SMTP username
SMTP_USER=

# OPTIONAL (SECRET): SMTP password
SMTP_PASS=

# OPTIONAL: From address for outgoing emails
SMTP_FROM=noreply@vaeloom.app

# ═══════════════════════════════════════════════════════════════════════════
# Slack Integration
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL (SECRET): Slack bot token
SLACK_BOT_TOKEN=

# OPTIONAL (SECRET): Slack signing secret
SLACK_SIGNING_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# Stripe
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL (SECRET): Stripe secret key
STRIPE_SECRET_KEY=

# OPTIONAL (SECRET): Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=

# OPTIONAL: Stripe API version
STRIPE_API_VERSION=2024-11-20.acacia

# ═══════════════════════════════════════════════════════════════════════════
# Plugins
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL: Plugin sandbox execution timeout in ms (default: 30000)
PLUGIN_SANDBOX_TIMEOUT=30000

# ═══════════════════════════════════════════════════════════════════════════
# Infrastructure (non-backend, used by docker-compose.prod.yml)
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED (SECRET): PostgreSQL password (for local Docker Compose deployments)
POSTGRES_PASSWORD=CHANGEME

# REQUIRED (SECRET): Redis password (for local Docker Compose deployments)
REDIS_PASSWORD=CHANGEME

# ═══════════════════════════════════════════════════════════════════════════
# Service Auth (inter-service communication)
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL (SECRET): Secret for inter-service JWT auth
SERVICE_AUTH_SECRET=

# OPTIONAL: Service auth token TTL in seconds (default: 60)
SERVICE_AUTH_TOKEN_TTL=60

# OPTIONAL (SECRET): Separate encryption key for integrations
INTEGRATION_ENCRYPTION_KEY=
