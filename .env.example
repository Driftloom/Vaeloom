# ─── Vaeloom Environment Configuration ───
# Required vars are validated via Zod schema in apps/api/src/config/env.validation.ts

# Application
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=debug
LOG_FORMAT=json
PORT=4000
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# AI Service
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_PROVIDER=anthropic

# Database
DATABASE_URL=postgresql://vaeloom:vaeloom_dev@localhost:5432/vaeloom

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
AUTH_TOKEN_TTL=3600
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800
JWT_ALGORITHM=HS256
JWT_ISSUER=vaeloom
AUTH_SECRET=change-me-in-production-min-32-chars-long

# Service-to-Service Auth
SERVICE_AUTH_SECRET=change-me-in-production-min-32-chars-long
SERVICE_AUTH_TOKEN_TTL=60

# Internal API Gateway
GATEWAY_TIMEOUT=10000
GATEWAY_RETRY_COUNT=2

# Encryption
ENCRYPTION_KEY=change-me-in-production-32-chars-min
INTEGRATION_ENCRYPTION_KEY=change-me-integration-enc-key-32chars

# Observability / Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vaeloom
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# S3-compatible Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=vaeloom
S3_SECRET_KEY=vaeloom_dev_minio
S3_BUCKET=vaeloom-storage
S3_FORCE_PATH_STYLE=true

# Service URLs (all 18 microservices)
MEMORY_STORE_URL=http://memory-store:3010
AUTH_SERVICE_URL=http://auth-service:3020
KNOWLEDGE_GRAPH_URL=http://knowledge-graph:3030
EVENT_BUS_URL=http://event-bus:3040
SEARCH_SERVICE_URL=http://search-service:3050
AGENT_ENGINE_URL=http://agent-engine:3060
ANALYTICS_SERVICE_URL=http://analytics-service:3070
AUDIT_SERVICE_URL=http://audit-service:3080
BILLING_SERVICE_URL=http://billing-service:3090
CONNECTOR_SERVICE_URL=http://connector-service:3100
DOCUMENT_INGESTION_URL=http://document-ingestion:3110
IAM_SERVICE_URL=http://iam-service:3120
INTEGRATION_SERVICE_URL=http://integration-service:3130
JOB_SCHEDULER_URL=http://job-scheduler:3140
NOTIFICATION_SERVICE_URL=http://notification-service:3150
PLUGIN_SERVICE_URL=http://plugin-service:3160
RBAC_SERVICE_URL=http://rbac-service:3170
RECOMMENDATION_SERVICE_URL=http://recommendation-service:3180

# Stripe (billing-service)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-11-20.acacia

# SMTP (notification-service)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vaeloom.dev

# Slack (notification-service)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Plugins
PLUGIN_SANDBOX_TIMEOUT=30000

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=10000
DB_POOL_MAX_USES=500

# PostgreSQL Extensions
POSTGRES_EXTENSIONS=pgcrypto,vector
