# ─── Vaeloom Environment Configuration ───

# Application
NODE_ENV=development
LOG_LEVEL=debug

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend (unified FastAPI, replaces api + ai-service + 18 microservices)
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# AI / LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_PROVIDER=anthropic

# Orchestrator (ADR-033/037): ReAct dynamic tool calling is opt-in (default off).
# 0 = deterministic static dispatch only (safe for local/tests/offline)
# 1 = enable LLM-driven tool calling + true token streaming in /agents/chat/stream
# Prod overlay sets AGENT_REACT_ENABLED=1 ; both tiers now share executor audit/timeout.
AGENT_REACT_ENABLED=0
# Optional: LLM-powered DAG planner for supervisor (heuristic is default). 1 = try LLM planner, fallback to heuristic.
# SUPERVISOR_LLM_PLANNER=0

# Database — Pydantic uses DATABASE__URL (double underscore). DATABASE_URL single-underscore
# is also accepted as a convenience alias (mapped in config). Prefer double-underscore.
DATABASE__URL=postgresql+asyncpg://vaeloom:vaeloom_dev@localhost:5432/vaeloom
# OP-RLS-01 role separation (production/Supabase):
# - DATABASE__URL / DATABASE_URL: least-privilege runtime role, NO BYPASSRLS
#   (e.g. vaeloom_app). The app refuses to boot in non-local envs otherwise.
# - DATABASE_MIGRATION__URL: owner/migrator URL, used ONLY for DDL + boot
#   migrations (create_all, alembic) and the startup role guard. Never the
#   runtime role.
#DATABASE_MIGRATION__URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@HOST:6543/postgres?ssl=require

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: openssl rand -hex 32 (32+ bytes required, fail-closed in ALL envs)
JWT_SECRET=
JWT_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800
JWT_ALGORITHM=HS256
JWT_ISSUER=vaeloom

# Service Auth (inter-service communication)
# Pre-filled dev-only default so `cp .env.example .env` works locally.
# For shared/staging/prod generate fresh: openssl rand -hex 32. Never reuse across machines.
SERVICE_AUTH_SECRET=dev-service-auth-secret-not-for-prod-32chars
SERVICE_AUTH_TOKEN_TTL=60

# Encryption — generate with: openssl rand -base64 32 (fail-closed, min 32 chars).
# NEVER reuse JWT_SECRET. Approval HMAC uses APPROVAL_HMAC_KEY (falls back to ENCRYPTION_KEY only).
ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY=
APPROVAL_HMAC_KEY=

# Observability / Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vaeloom
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# S3-compatible Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=vaeloom
STORAGE_SECRET_KEY=vaeloom_dev_minio
STORAGE_BUCKET=vaeloom-storage
STORAGE_REGION=us-east-1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-11-20.acacia

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vaeloom.dev

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# GitHub (native tools + fallback for MCP header auth; prefer per-workspace connector token_ref)
GITHUB_TOKEN=
# GITHUB_API_KEY=  # alias, either name accepted

# Google Workspace (single refresh token serves Gmail + Calendar + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Microsoft Graph — Outlook mail + Graph Calendar + OneDrive (aliases: MICROSOFT_* also accepted)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REFRESH_TOKEN=
MS_GRAPH_TENANT_ID=common
# MICROSOFT_CLIENT_ID=  # alias
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REFRESH_TOKEN=

# Job boards — generic REST (optional; Greenhouse/Lever public APIs need no keys)
JOB_BOARD_API_URL=
JOB_BOARD_API_KEY=

# Browser / scraping
BROWSER_TOOLS_ENABLED=true
SCRAPE_QUOTA_PER_HOUR=20

# MCP — per-connector env/headers are stored encrypted; globals are timeouts only
# MCP_DISCOVERY_TTL_S=300  # via code constant

# Rate Limiting — Redis-backed distributed limits required in prod/multi-worker.
# Defaults are fail-closed friendly: 60/min default per client, 500/min API-key.
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Async Task Orchestration & Durable Execution (Trigger.dev / Redis BullMQ / Temporal)
BACKGROUND_ENGINE=auto
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_PROJECT_ID=

# Temporal (ADR-038) — durable workflows (off by default locally)
TEMPORAL_ENABLED=false
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=   # Temporal Cloud
# TEMPORAL_TLS=false
# TEMPORAL_TASK_QUEUE_INGEST=vaeloom-ingest-q

# LangGraph (ADR-039) — agent reasoning topology (Temporal owns durability, off by default)
# LANGGRAPH_ENABLED=false — set true to run StateGraph inside DurableAgentRunActivity
# LANGGRAPH_SHADOW_MODE=false — if true, runs both legacy and graph, returns legacy (parity check)
# LANGGRAPH_AGENT_RUN_PERCENT=0 — 0=legacy only, 100=graph only, 1-99 shadow percent gating via request_id hash
LANGGRAPH_ENABLED=false
LANGGRAPH_VERSION=v1
LANGGRAPH_SHADOW_MODE=false
LANGGRAPH_AGENT_RUN_PERCENT=0
LANGGRAPH_CHECKPOINT_BACKEND=memory

# Plugins
PLUGIN_SANDBOX_TIMEOUT=30000

# Composio SaaS Integration (https://app.composio.dev/settings)
COMPOSIO_API_KEY=

