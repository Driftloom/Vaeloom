# ─── Vaeloom Environment Configuration ───

# Application
NODE_ENV=development
LOG_LEVEL=debug

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend (unified FastAPI, replaces api + ai-service + 18 microservices)
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# AI / LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_PROVIDER=anthropic

# Database
DATABASE_URL=postgresql+asyncpg://vaeloom:vaeloom_dev@localhost:5432/vaeloom

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800
JWT_ALGORITHM=HS256
JWT_ISSUER=vaeloom

# Service Auth (inter-service communication)
SERVICE_AUTH_SECRET=dev-service-auth-secret-not-for-prod-32chars
SERVICE_AUTH_TOKEN_TTL=60

# Encryption
ENCRYPTION_KEY=change-me-in-production-32-chars-min
INTEGRATION_ENCRYPTION_KEY=change-me-integration-enc-key-32chars

# Observability / Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vaeloom
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# S3-compatible Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=vaeloom
STORAGE_SECRET_KEY=vaeloom_dev_minio
STORAGE_BUCKET=vaeloom-storage
STORAGE_REGION=us-east-1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-11-20.acacia

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vaeloom.dev

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Plugins
PLUGIN_SANDBOX_TIMEOUT=30000
