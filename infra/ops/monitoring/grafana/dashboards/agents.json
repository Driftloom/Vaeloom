{
  "title": "Vaeloom Agents",
  "uid": "vaeloom-agents",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": ["vaeloom", "agents"],
  "refresh": "30s",
  "panels": [
    {
      "title": "Agent Executions (rate)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(agent_executions_total[$__rate_interval])",
          "legendFormat": "{{agent_id}} - {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        }
      }
    },
    {
      "title": "Agent Success Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "rate(agent_executions_total{status=\"success\"}[5m]) / rate(agent_executions_total[5m]) * 100",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "Token Usage",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(agent_token_usage_total[$__rate_interval])",
          "legendFormat": "{{agent_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        }
      }
    },
    {
      "title": "Agent Execution Duration p50 / p95 / p99",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(agent_execution_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(agent_execution_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(agent_execution_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Active Agents",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "count(agent_executions_total) by (agent_id)",
          "legendFormat": "active agents",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Errors by Agent",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 4, "y": 16},
      "targets": [
        {
          "expr": "rate(agent_executions_total{status=\"failure\"}[5m])",
          "legendFormat": "{{agent_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "LLM Calls (rate)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "targets": [
        {
          "expr": "rate(llm_calls_total[$__rate_interval])",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    }
  ]
}
