{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "LangGraph Agent Runs Started",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(langgraph_run_started_total[5m])) by (agent)",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "LangGraph Agent Runs Completed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(langgraph_run_completed_total[5m])) by (agent, mode)",
          "legendFormat": "{{agent}} ({{mode}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "LangGraph Agent Failures & Interrupts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(langgraph_run_failed_total[5m])) by (reason)",
          "legendFormat": "Failed: {{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(langgraph_interrupt_total[5m])) by (reason)",
          "legendFormat": "Interrupt: {{reason}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "Agent Execution Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(langgraph_run_duration_seconds_bucket[5m])) by (le, agent))",
          "legendFormat": "{{agent}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Tool Executions by Tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(langgraph_tool_execution_total[5m])) by (tool)",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "Approval Signal Wait Time (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(temporal_approval_wait_seconds_bucket[5m])) by (le))",
          "legendFormat": "Approval Wait p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Temporal Workflows Started & Fallbacks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(temporal_workflow_started_total[5m])) by (workflow_type)",
          "legendFormat": "{{workflow_type}} started",
          "refId": "A"
        },
        {
          "expr": "sum(rate(temporal_fallback_total[5m])) by (workflow_type)",
          "legendFormat": "{{workflow_type}} local fallback",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "Temporal Active Workflows by Queue",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(temporal_active_workflows) by (task_queue)",
          "legendFormat": "{{task_queue}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["vaeloom", "agents", "langgraph", "temporal"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Vaeloom Agent Operations",
  "uid": "vaeloom-agents",
  "version": 1
}
