{
  "extends": "@vaeloom/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
