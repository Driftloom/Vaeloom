{# Minimalist Clean — high whitespace, thin dividers, sleek hierarchy #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 20mm 22mm; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: {{ template.font_stack }}; color: #27272a; font-size: 10pt; line-height: 1.55; font-weight: 400; }
  .header h1 { font-size: 22pt; font-weight: 300; letter-spacing: -0.5pt; color: #18181b; }
  .header .title { font-size: 11pt; color: #52525b; margin-top: 2pt; }
  .contact { margin-top: 8pt; font-size: 9pt; color: #71717a; display: flex; flex-wrap: wrap; gap: 3pt 16pt; }
  .divider { border-top: 0.5pt solid #e4e4e7; margin: 12pt 0 10pt 0; }
  section { margin-top: 6pt; }
  h2 { font-size: 9.5pt; text-transform: uppercase; letter-spacing: 2pt; color: {{ template.accent_color }};
       font-weight: 600; margin-bottom: 8pt; }
  .entry { margin-bottom: 10pt; page-break-inside: avoid; }
  .entry-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1pt; }
  .entry-head .left { font-weight: 500; font-size: 10.5pt; color: #18181b; }
  .entry-head .right { font-size: 8.5pt; color: #a1a1aa; letter-spacing: 0.5pt; white-space: nowrap; }
  .entry-sub { font-size: 9.5pt; color: #71717a; margin-bottom: 3pt; }
  ul { list-style: none; }
  li { position: relative; padding-left: 14pt; margin-bottom: 3pt; color: #3f3f46; }
  li::before { content: ""; position: absolute; left: 2pt; top: 0.62em; width: 4pt; height: 4pt;
               border-radius: 50%; background: {{ template.accent_color }}; }
  .skills-line { margin-bottom: 4pt; }
  .skills-line b { font-weight: 500; color: #18181b; }
</style>
</head>
<body>
  <div class="header">
    <h1>{{ name }}</h1>
    {% if title %}<div class="title">{{ title }}</div>{% endif %}
    <div class="contact">
      {% if email %}<span>{{ email }}</span>{% endif %}
      {% if phone %}<span>{{ phone }}</span>{% endif %}
      {% if location %}<span>{{ location }}</span>{% endif %}
      {% if links.portfolio %}<span>{{ links.portfolio }}</span>{% endif %}
      {% if links.linkedin %}<span>{{ links.linkedin }}</span>{% endif %}
    </div>
  </div>

  <div class="divider"></div>

  {% if summary %}
  <section><h2>Profile</h2><p>{{ summary }}</p></section>
  {% endif %}

  {% if experience %}
  <section>
    <h2>Experience</h2>
    {% for e in experience %}
    <div class="entry">
      <div class="entry-head">
        <span class="left">{{ e.role }}{% if e.company %} &middot; {{ e.company }}{% endif %}</span>
        <span class="right">{% if e.start %}{{ e.start }} &mdash; {{ e.end or "PRESENT" }}{% endif %}</span>
      </div>
      {% if e.location %}<div class="entry-sub">{{ e.location }}</div>{% endif %}
      {% if e.bullets %}<ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if projects %}
  <section>
    <h2>Projects</h2>
    {% for p in projects %}
    <div class="entry">
      <div class="entry-head"><span class="left">{{ p.name }}</span></div>
      {% if p.description %}<p>{{ p.description }}</p>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if skills %}
  <section>
    <h2>Skills</h2>
    {% for g in skills %}<div class="skills-line"><b>{{ g.category }}</b> &nbsp;{{ g['items'] | map(attribute='name') | join("  ·  ") }}</div>{% endfor %}
  </section>
  {% endif %}

  {% if education %}
  <section>
    <h2>Education</h2>
    {% for ed in education %}
    <div class="entry">
      <div class="entry-head">
        <span class="left">{{ ed.degree }}</span>
        <span class="right">{% if ed.start %}{{ ed.start }} &mdash; {{ ed.end }}{% endif %}</span>
      </div>
      <div class="entry-sub">{{ ed.institution }}{% if ed.details %} &middot; {{ ed.details }}{% endif %}</div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if certifications %}
  <section><h2>Certifications</h2><ul>{% for c in certifications %}<li>{{ c }}</li>{% endfor %}</ul></section>
  {% endif %}
</body>
</html>
