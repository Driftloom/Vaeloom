{# Tech Modern — clean technical, accent color, categorized skill badges #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 14mm 16mm; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: {{ template.font_stack }}; color: #1f2937; font-size: 10pt; line-height: 1.5; }
  a { color: {{ template.accent_color }}; text-decoration: none; }
  .header { border-left: 4pt solid {{ template.accent_color }}; padding-left: 12pt; margin-bottom: 10pt; }
  .header h1 { font-size: 21pt; font-weight: 700; letter-spacing: -0.5pt; color: #111827; }
  .header .title { font-size: 11.5pt; color: {{ template.accent_color }}; font-weight: 500; margin-top: 1pt; }
  .contact { margin-top: 5pt; font-size: 9.5pt; color: #4b5563; display: flex; flex-wrap: wrap; gap: 4pt 14pt; }
  section { margin-top: 10pt; }
  h2 { font-size: 11pt; text-transform: uppercase; letter-spacing: 1pt; color: {{ template.accent_color }};
       border-bottom: 1pt solid #e5e7eb; padding-bottom: 3pt; margin-bottom: 7pt; font-weight: 700; }
  .entry { margin-bottom: 8pt; page-break-inside: avoid; }
  .entry-head { display: flex; justify-content: space-between; align-items: baseline; }
  .entry-head .left { font-weight: 700; font-size: 10.5pt; color: #111827; }
  .entry-head .right { font-size: 9pt; color: #6b7280; background: #f3f4f6; padding: 1pt 6pt; border-radius: 8pt; white-space: nowrap; }
  .entry-sub { font-size: 9.5pt; color: {{ template.accent_color }}; font-weight: 600; margin-top: 1pt; }
  ul { list-style: none; margin-left: 0; margin-top: 3pt; }
  li { position: relative; padding-left: 12pt; margin-bottom: 2.5pt; }
  li::before { content: "▸"; position: absolute; left: 0; color: {{ template.accent_color }}; }
  .badge-grid { display: flex; flex-wrap: wrap; gap: 4pt; margin-bottom: 5pt; }
  .badge { background: #eff6ff; color: #1e40af; border: 0.75pt solid #bfdbfe; border-radius: 3pt;
           padding: 1.5pt 7pt; font-size: 8.5pt; font-weight: 500; }
  .skills-cat { font-weight: 700; font-size: 9pt; color: #374151; text-transform: uppercase; letter-spacing: 0.5pt; margin-bottom: 2pt; }
</style>
</head>
<body>
  <div class="header">
    <h1>{{ name }}</h1>
    {% if title %}<div class="title">{{ title }}</div>{% endif %}
    <div class="contact">
      {% if email %}<span>{{ email }}</span>{% endif %}
      {% if phone %}<span>{{ phone }}</span>{% endif %}
      {% if location %}<span>{{ location }}</span>{% endif %}
      {% if links.github %}<span><a href="{{ links.github }}">GitHub</a></span>{% endif %}
      {% if links.linkedin %}<span><a href="{{ links.linkedin }}">LinkedIn</a></span>{% endif %}
      {% if links.portfolio %}<span><a href="{{ links.portfolio }}">Portfolio</a></span>{% endif %}
    </div>
  </div>

  {% if summary %}
  <section><h2>About</h2><p>{{ summary }}</p></section>
  {% endif %}

  {% if skills %}
  <section>
    <h2>Technical Skills</h2>
    {% for g in skills %}
    <div class="skills-cat">{{ g.category }}</div>
    <div class="badge-grid">{% for s in g['items'] %}<span class="badge">{{ s.name }}</span>{% endfor %}</div>
    {% endfor %}
  </section>
  {% endif %}

  {% if experience %}
  <section>
    <h2>Experience</h2>
    {% for e in experience %}
    <div class="entry">
      <div class="entry-head">
        <span class="left">{{ e.role }} &middot; {{ e.company }}</span>
        <span class="right">{% if e.start %}{{ e.start }} &ndash; {{ e.end or "Present" }}{% endif %}</span>
      </div>
      {% if e.location %}<div class="entry-sub">{{ e.location }}</div>{% endif %}
      {% if e.bullets %}<ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if projects %}
  <section>
    <h2>Projects</h2>
    {% for p in projects %}
    <div class="entry">
      <div class="entry-head"><span class="left">{{ p.name }}</span>{% if p.link %}<span class="right"><a href="{{ p.link }}">{{ p.link }}</a></span>{% endif %}</div>
      {% if p.description %}<p>{{ p.description }}</p>{% endif %}
      {% if p.highlights %}<ul>{% for h in p.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if education %}
  <section>
    <h2>Education</h2>
    {% for ed in education %}
    <div class="entry">
      <div class="entry-head">
        <span class="left">{{ ed.degree }}{% if ed.details %} &mdash; {{ ed.details }}{% endif %}</span>
        <span class="right">{% if ed.start %}{{ ed.start }} &ndash; {{ ed.end }}{% endif %}</span>
      </div>
      <div class="entry-sub">{{ ed.institution }}</div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if certifications %}
  <section><h2>Certifications</h2><ul>{% for c in certifications %}<li>{{ c }}</li>{% endfor %}</ul></section>
  {% endif %}
</body>
</html>
