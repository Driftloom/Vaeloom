# ==============================================================================
# VAELOOM BACKEND PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# Governing Contract: Zero-Trust, Fail-Closed, Cloud-Native Deployment
# Copy this file to .env.production and populate all secrets before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY (FAIL-FAST IN PRODUCTION)
# ------------------------------------------------------------------------------
SERVICE_NAME=vaeloom-api
SERVICE_VERSION=0.2.0
SERVICE_ENVIRONMENT=production

# Mandatory: 32+ character high-entropy cryptographically secure secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-very-strong-random-secret-at-least-32-chars-long!!
JWT_ALGORITHM=HS256
JWT_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=2592000

# Mandatory: 32-byte Base64 key for AES-256-GCM encryption of connector secrets & BYOK
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=replace-with-32-byte-base64-encryption-key-here==

# Mandatory: Strict production allowed origins (NO localhost permitted in production)
ALLOWED_ORIGINS=["https://app.vaeloom.app","https://vaeloom.app"]

# ------------------------------------------------------------------------------
# 2. MANAGED CLOUD DATABASE (SUPABASE POSTGRESQL + PGBOUNCER)
# Console: https://supabase.com/dashboard
# ------------------------------------------------------------------------------
# Connect using asyncpg driver + Port 6543 (Transaction Pooler) + SSL
# Format: postgresql+asyncpg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE__URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# 3. HIGH-SPEED IN-MEMORY LAYER (MANAGED REDIS / UPSTASH)
# Console: https://console.upstash.com/redis
# ------------------------------------------------------------------------------
# Protocol must be TLS rediss://
REDIS__URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379
RATE_LIMIT_REDIS_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (SUPABASE STORAGE / AWS S3)
# Console: https://supabase.com/dashboard (Project Settings -> Storage -> S3 Keys)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=your-supabase-s3-access-key
STORAGE_SECRET_KEY=your-supabase-s3-secret-key
STORAGE_BUCKET=vaeloom-production-artifacts
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 5. VECTOR & FULL-TEXT SEARCH ACCELERATION (QDRANT & MEILISEARCH)
# Qdrant: https://cloud.qdrant.io/
# Meilisearch: https://cloud.meilisearch.com/
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
MEILISEARCH_URL=https://your-project-id.meilisearch.io
MEILISEARCH_API_KEY=your-meilisearch-master-key

# ------------------------------------------------------------------------------
# 6. AI & REASONING ENGINES
# Anthropic: https://console.anthropic.com/settings/keys
# OpenAI: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-api03-your-anthropic-api-key
LLM_MODEL=claude-3-5-sonnet-20241022
EMBEDDING_MODEL=text-embedding-3-small
AGENT_REACT_ENABLED=1

# ------------------------------------------------------------------------------
# 7. BROWSER AUTOMATION & RESILIENCY
# (Playwright Chromium runs inside the container with 2GB shm_size)
# ------------------------------------------------------------------------------
BROWSER_TOOLS_ENABLED=true
SCRAPE_QUOTA_PER_HOUR=50
AGENT_TIMEOUT_SECONDS=120
AGENT_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_RECOVERY_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 8. DURABLE WORKFLOWS (TEMPORAL)
# Console: https://cloud.temporal.io/
# ------------------------------------------------------------------------------
TEMPORAL_ENABLED=true
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_INGEST=vaeloom-ingest-q
TEMPORAL_TASK_QUEUE_AGENT=vaeloom-agent-q
TEMPORAL_TASK_QUEUE_CONNECTORS=vaeloom-connectors-q
TEMPORAL_TASK_QUEUE_SCHEDULES=vaeloom-schedules-q

# ------------------------------------------------------------------------------
# 9. OBSERVABILITY & MONITORING
# Sentry: https://sentry.io/
# ------------------------------------------------------------------------------
SENTRY_DSN=
OTEL_SERVICE_NAME=vaeloom-api
OTEL_SDK_DISABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 10. THIRD-PARTY INTEGRATION CREDENTIALS (ZERO-TRUST TOKENS)
# ------------------------------------------------------------------------------
# GitHub PAT (Enables live PR and issue creation): https://github.com/settings/tokens
GITHUB_TOKEN=

# Google OAuth2 (Gmail, Drive, Calendar): https://console.cloud.google.com/apis/credentials
# Token generation: https://developers.google.com/oauthplayground/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Microsoft Graph OAuth2 (Outlook, OneDrive): https://portal.azure.com/
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REFRESH_TOKEN=
MS_GRAPH_TENANT_ID=common

# Job Boards (Greenhouse / Lever):
# Greenhouse: https://app.greenhouse.io/configure/dev_center/credentials
# Lever: https://hire.lever.co/settings/integrations
JOB_BOARD_API_KEY=
JOB_BOARD_API_URL=

# Team Messaging (Slack & Notion):
# Slack: https://api.slack.com/apps
# Notion: https://www.notion.so/my-integrations
SLACK_BOT_TOKEN=
NOTION_TOKEN=
