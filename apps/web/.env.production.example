# ==============================================================================
# VAELOOM FRONTEND PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# Copy this file to apps/web/.env.production before building or deploying.
# ==============================================================================

# Public API Gateway Base URL
NEXT_PUBLIC_API_URL=https://api.vaeloom.app

# Canonical Application URL
NEXT_PUBLIC_SITE_URL=https://vaeloom.app

# Feature Flags
# Enterprise views are gated by the server-derived capability on /auth/me (tenant entitlement), not an env flag.

# Error Tracking destination (client crash/error + event reports).
# Set to any JSON-ingest collector: a Sentry envelope URL, GlitchTip,
# Better Stack Logtail, or a first-party /client-errors endpoint. Leave blank to
# keep reporting console-only (dev). The collector origin MUST be listed in the
# CSP connect-src allowlist (middleware.ts / next.config.js) or the browser
# silently blocks the beacon. When set, the crash UI honestly says a report was
# sent; when blank it does not.
NEXT_PUBLIC_ERROR_REPORT_URL=

# Performance Analytics / Web Vitals
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://analytics.vaeloom.app/vitals

# Algolia InstantSearch (Frontend Read-Only Search Key)
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_PREFIX=vaeloom
