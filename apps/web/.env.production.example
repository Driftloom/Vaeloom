# ==============================================================================
# VAELOOM FRONTEND PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# Copy this file to apps/web/.env.production before building or deploying.
# ==============================================================================

# Public API Gateway Base URL
NEXT_PUBLIC_API_URL=https://api.vaeloom.app

# Canonical Application URL
NEXT_PUBLIC_SITE_URL=https://vaeloom.app

# Feature Flags
# Enable enterprise management views (Organizations, Audit Logs, Custom Connectors)
NEXT_PUBLIC_ENABLE_ENTERPRISE=true

# Error Tracking (Sentry: https://sentry.io/)
NEXT_PUBLIC_SENTRY_DSN=

# Performance Analytics / Web Vitals
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://analytics.vaeloom.app/vitals
