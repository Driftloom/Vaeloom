{
  "extends": "@vaeloom/tsconfig/nextjs.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next-e2e-d1440/types/**/*.ts",
    ".next-e2e-det/types/**/*.ts",
    ".next-e2e-det2/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "trigger.config.ts",
    ".next-e2e-base/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.spec.tsx", "**/*.test.ts", "**/*.test.tsx"]
}
