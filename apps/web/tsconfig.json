{
  "extends": "@vaeloom/tsconfig/nextjs.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react", "./node_modules/react"],
      "react-dom": ["./node_modules/@types/react-dom", "./node_modules/react-dom"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next-build2/types/**/*.ts",
    ".next-e2e-full/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "trigger.config.ts",
    ".next-e2e-triage/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.spec.tsx", "**/*.test.ts", "**/*.test.tsx"]
}
