# ─── Vaeloom Unified Backend ───

# Service
SERVICE_NAME=vaeloom-backend
SERVICE_VERSION=0.2.0
SERVICE_ENVIRONMENT=local
LOG_LEVEL=DEBUG

# Database (asyncpg)
DATABASE__URL=postgresql+asyncpg://vaeloom:vaeloom_dev@localhost:5432/vaeloom

# Redis
REDIS__URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=2592000

# LLM Provider
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
EMBEDDING_MODEL=text-embedding-3-small

# Google (Gmail/Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Job Board
JOB_BOARD_API_URL=
JOB_BOARD_API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# S3-compatible Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=vaeloom
STORAGE_SECRET_KEY=vaeloom_dev_minio
STORAGE_BUCKET=vaeloom-storage
STORAGE_REGION=us-east-1
