# .env.test.example — Environment variables for Module 05 integration & live tests
# Copy to .env.test or set in PowerShell environment.

# ===========================================================================
# Object Storage (MinIO local integration testing)
# Start: docker-compose -f docker-compose.test.yml up -d
# ===========================================================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=vaeloom-test-bucket
STORAGE_REGION=us-east-1
STORAGE_MIRROR_ENABLED=true

# ===========================================================================
# LLM Provider (Ollama local / Cloud API)
# Ollama: ollama serve && ollama run gemma3:latest
# ===========================================================================
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest
# Or Cloud Provider:
# LLM_PROVIDER=google
# LLM_API_KEY=your_gemini_api_key_here

# ===========================================================================
# Database
# ===========================================================================
DATABASE__URL=sqlite+aiosqlite:///./test-integration.db

# ===========================================================================
# Auth Security
# ===========================================================================
JWT_SECRET=test-jwt-secret-for-ci-only-32-chars-long!!
ENCRYPTION_KEY=dGVzdC1lbmNyeXB0aW9uLWtleS1mb3ItY2k=

# ===========================================================================
# Browser E2E (Playwright)
# ===========================================================================
TEST_WORKSPACE_ID=test-ws-id
TEST_EMAIL=audit@vaeloom.test
TEST_PASSWORD=AuditPass123!
