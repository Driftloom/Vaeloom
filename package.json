{
  "name": "vaeloom",
  "private": true,
  "description": "Vaeloom — Memory-first personal intelligence platform",
  "scripts": {
    "dev": "echo \"Use pnpm dev:web (frontend) or pnpm dev:be (API) - bare pnpm dev is disabled\" && exit 1",
    "dev:web": "nx run @vaeloom/web:dev",
    "dev:be": "uv run --project apps/api uvicorn api.main:app --reload --port 8000",
    "dev:api": "uv run --project apps/api uvicorn api.main:app --reload --port 8000",
    "build": "nx run-many --target=build --parallel",
    "build:web": "nx run @vaeloom/web:build",
    "test": "nx run-many --target=test --parallel",
    "test:e2e": "pnpm --filter @vaeloom/web test:e2e",
    "test:e2e:visual": "pnpm --filter @vaeloom/web test:e2e:visual",
    "test:e2e:all": "pnpm --filter @vaeloom/web test:e2e:all",
    "lint": "nx run-many --target=lint --parallel",
    "typecheck": "nx run-many --target=typecheck --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "gen:openapi": "uv run --project apps/api python scripts/gen_openapi.py",
    "verify:pg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_pg_verification.ps1",
    "verify:migrations": "uv run --project apps/api python scripts/verify_pg_migrations.py",
    "clean": "nx reset && rimraf node_modules packages/*/node_modules apps/*/node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "nx": "23.3.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
