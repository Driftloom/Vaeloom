{
  "name": "vaeloom",
  "private": true,
  "description": "Vaeloom — Memory-first personal intelligence platform",
  "scripts": {
    "dev": "nx run-many --target=dev --parallel",
    "dev:web": "nx run @vaeloom/web:dev",
    "dev:be": "cd apps/backend && uvicorn backend.main:app --reload --port 8000",
    "build": "nx run-many --target=build --parallel",
    "build:web": "nx run @vaeloom/web:build",
    "test": "nx run-many --target=test --parallel",
    "lint": "nx run-many --target=lint --parallel",
    "typecheck": "nx run-many --target=typecheck --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "clean": "nx reset && rimraf node_modules packages/*/node_modules apps/*/node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.51.1",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "nx": "20.0.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "eslint": "^8.57.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "8"
      }
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
