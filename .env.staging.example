# Staging — ISOLATED from dev/prod. Fill with staging-only secrets; never reuse production values.
# Usage: cp .env.staging.example .env.staging && edit, then: docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build
STAGING_POSTGRES_PASSWORD=change-me-staging-pg-32chars-min
STAGING_POSTGRES_PORT=5543
STAGING_REDIS_PASSWORD=change-me-staging-redis-32chars-min
STAGING_REDIS_PORT=6380
STAGING_API_PORT=18000
STAGING_JWT_SECRET=change-me-staging-jwt-32chars-min
STAGING_ENCRYPTION_KEY=change-me-staging-enc-32chars-min
# Optional overrides for staging gate (all default to isolated local values above)
# STAGING_DATABASE_URL=postgresql+asyncpg://vaeloom_staging:${STAGING_POSTGRES_PASSWORD}@localhost:${STAGING_POSTGRES_PORT}/vaeloom_staging
# STAGING_REDIS_URL=redis://:${STAGING_REDIS_PASSWORD}@localhost:${STAGING_REDIS_PORT}/0
