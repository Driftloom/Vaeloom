{
  "title": "Vaeloom Latency",
  "uid": "vaeloom-latency",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": ["vaeloom", "latency"],
  "refresh": "30s",
  "panels": [
    {
      "title": "Per-Endpoint Latency p50",
      "type": "table",
      "gridPos": {"h": 10, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "transformations": [
        {"id": "groupBy", "options": {"fields": {"Value": {"aggregations": ["mean"]}, "path": {"aggregations": ["duplicates"]}}}}
      ]
    },
    {
      "title": "Per-Endpoint Latency p95",
      "type": "table",
      "gridPos": {"h": 10, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Per-Endpoint Latency p99",
      "type": "table",
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Request Duration Heatmap",
      "type": "heatmap",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 10},
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_bucket[$__rate_interval])",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "heatmap": {
        "yBucketBound": "auto",
        "yBucketNumber": 20
      }
    },
    {
      "title": "Latency by HTTP Method",
      "type": "graph",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 10},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{method=\"GET\"}[$__rate_interval]))",
          "legendFormat": "GET",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{method=\"POST\"}[$__rate_interval]))",
          "legendFormat": "POST",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{method=\"PUT\"}[$__rate_interval]))",
          "legendFormat": "PUT",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{method=\"DELETE\"}[$__rate_interval]))",
          "legendFormat": "DELETE",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Top-10 Workspaces by Request Volume",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "topk(10, sum by (workspace) (rate(http_requests_total[$__rate_interval])))",
          "legendFormat": "{{workspace}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Latency by Workspace (Top-10 p95)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[$__rate_interval]))) by (workspace)",
          "legendFormat": "{{workspace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Slow Endpoints (p95 > 500ms)",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[$__rate_interval])) > 0.5",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ]
}
